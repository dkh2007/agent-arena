{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-arena.local/schemas/diagnosis-report-v2.json",
  "title": "诊断报告 DTO v2（评测层 -> 状态层 的唯一接口）",
  "description": "只装评测层能判定的事实：每条断言的观测、四态、命中的错误模式；以及派生出来的两段式分数（gate / credit）与技能缺口聚合。不含推断（复习建议、掌握度均在状态层产生）。v2 相对 v1 的破坏性变更：rubric 拆成 gate/credit 两层，分母改为 credit 权重之和，新增 disqualified 与 unattributed_patterns。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_version",
    "submission",
    "trace_audit",
    "score",
    "attribution_policy",
    "report_attribution",
    "process_fact",
    "assertions",
    "skill_gaps",
    "unattributed_patterns"
  ],
  "properties": {
    "report_version": { "const": "v2" },
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["submission_id", "task_id", "task_git_hash", "agent_id", "evaluated_at"],
      "properties": {
        "submission_id": { "type": "string", "minLength": 1 },
        "task_id": { "type": "string", "minLength": 1 },
        "task_git_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$",
          "description": "产生本报告的 YAML 版本；没有它，报告里的断言 id 无法与任务对齐"
        },
        "task_version": {
          "type": "string",
          "minLength": 1,
          "description": "提交针对的任务版本号，与任务 YAML 的 task_version 比对（TD-038）。缺省表示提交方未携带版本信息，此时**不做比对**（向后兼容，见 review-response-v1.md §60）；带上了却不一致 ⇒ 本份作废（voided），分数不算、不计掌握度、提示按当前版本重交"
        },
        "agent_id": { "type": "string", "minLength": 1 },
        "process_note": {
          "type": "string",
          "minLength": 1,
          "description": "提交方对本次做题过程的文字说明（P2 / Q5-D1）。非空即视为『交了步骤』——写一句『不会/没思路』也算，避免把『没写』当成『不会』。与 trace 二选一即可满足过程要求"
        },
        "evaluated_at": { "type": "string", "format": "date-time" },
        "invoke": {
          "type": "object",
          "additionalProperties": false,
          "required": ["duration_ms", "timeout_seconds", "platform_retries"],
          "properties": {
            "duration_ms": { "type": "integer", "minimum": 0 },
            "timeout_seconds": { "type": "integer", "minimum": 1 },
            "platform_retries": {
              "const": 0,
              "description": "平台绝不代劳重试：重试是被测能力，平台重试会让 R3 失效"
            }
          }
        }
      }
    },
    "trace_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reported", "schema_valid", "invalid_reasons", "call_count"],
      "description": "trace 前置校验结果。A2E 的教训是『读不到 trace 时静默降级并给满分』，所以这里必须显式记录，不许静默。",
      "properties": {
        "reported": { "type": "boolean" },
        "schema_valid": { "type": "boolean" },
        "invalid_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/traceInvalidReason" },
          "uniqueItems": true
        },
        "call_count": { "type": "integer", "minimum": 0 },
        "final_status": { "enum": ["completed", "crashed", "timeout"] }
      },
      "allOf": [
        {
          "if": { "properties": { "reported": { "const": false } }, "required": ["reported"] },
          "then": {
            "properties": {
              "schema_valid": { "const": false },
              "call_count": { "const": 0 },
              "invalid_reasons": { "minItems": 1 }
            }
          }
        },
        {
          "if": { "properties": { "schema_valid": { "const": true } }, "required": ["schema_valid"] },
          "then": { "properties": { "invalid_reasons": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "schema_valid": { "const": false } }, "required": ["schema_valid"] },
          "then": { "properties": { "invalid_reasons": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "reported": { "const": false } }, "required": ["reported"] },
          "then": { "not": { "required": ["final_status"] } }
        }
      ]
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weighted_sum",
        "counterfactual_credit",
        "total_weight",
        "ratio",
        "denominator_policy",
        "disqualified",
        "disqualifying_assertions",
        "by_state"
      ],
      "description": "两段式分数。gate 决定『有没有资格被评分』，credit 决定『评多少分』。两者分开是为了让分数单调：不做事 < 做错 < 只对一半 < 全对。",
      "properties": {
        "weighted_sum": {
          "type": "number",
          "minimum": 0,
          "description": "最终得分分子。disqualified 时恒为 0，否则等于 counterfactual_credit"
        },
        "counterfactual_credit": {
          "type": "number",
          "minimum": 0,
          "description": "反事实得分：credit 层通过的权重之和，语义是『若通过门禁本可得几分』。门禁未过时仍照算（诊断信息不丢），但它**不是分数**、不参与 ratio，第三方汇总不得把它当分数读。该值与 assertions 里 pass 的 credit 断言始终自洽。原名 credit_pass_weight（round-70 按 Q1 呈现口径改名，避免与 ratio 并列时被当成分子）",
          "x-previous-name": "credit_pass_weight"
        },
        "total_weight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "credit 层权重之和（本任务 4）。门禁不计权重，所以这不是全部断言的权重和"
        },
        "ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "denominator_policy": {
          "const": "fixed_at_credit_total_weight",
          "description": "分母恒为 credit 层权重之和，不因断言缺失而缩小（P4）。gate 不在分母里——它没有权重"
        },
        "disqualified": {
          "type": "boolean",
          "description": "是否有门禁断言 fail。true 表示本次提交无资格评分，ratio 记 0"
        },
        "disqualifying_assertions": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "description": "哪一个门禁拦下了这次提交。状态层据此知道『未交产物』而不是面对空的 skill_gaps 猜（P5）"
        },
        "by_state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pass", "fail", "blocked", "unscored"],
          "description": "全部断言（gate + credit）的状态计数，用于快速核对报告完整性",
          "properties": {
            "pass": { "type": "integer", "minimum": 0 },
            "fail": { "type": "integer", "minimum": 0 },
            "blocked": { "type": "integer", "minimum": 0 },
            "unscored": { "type": "integer", "minimum": 0 }
          }
        },
        "voided": {
          "type": "boolean",
          "description": "本份提交作废（TD-038）：任务版本与当前不一致等『不是学生不会』的原因。作废时 ratio 记 0、report_attribution 全 false，但**断言判定照常保留**（诊断不吞）。与 disqualified 的区别：disqualified 是学生没交东西/没跑完，voided 是这次不算数、需按当前版本重交"
        },
        "void_reason": {
          "type": "string",
          "enum": ["task_version_mismatch"],
          "description": "作废原因码，仅 voided=true 时必填"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "disqualified": { "const": true } }, "required": ["disqualified"] },
          "then": {
            "properties": {
              "disqualifying_assertions": { "minItems": 1 },
              "weighted_sum": { "const": 0 },
              "ratio": { "const": 0 }
            }
          }
        },
        {
          "if": { "properties": { "disqualified": { "const": false } }, "required": ["disqualified"] },
          "then": { "properties": { "disqualifying_assertions": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "voided": { "const": true } }, "required": ["voided"] },
          "then": {
            "required": ["void_reason"],
            "properties": { "weighted_sum": { "const": 0 }, "ratio": { "const": 0 } }
          }
        }
      ]
    },
    "attribution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "fail", "blocked", "unscored"],
      "description": "从任务 YAML 的 scoring.attribution 抄来（去掉人类可读的 reason），让报告自解释：状态层不需要再回头读 YAML 才知道哪些状态算掌握度。",
      "properties": {
        "pass": { "$ref": "#/$defs/attribution" },
        "fail": { "$ref": "#/$defs/attribution" },
        "blocked": { "$ref": "#/$defs/attribution" },
        "unscored": { "$ref": "#/$defs/attribution" }
      }
    },
    "report_attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["counts_toward_mastery", "emit_error_patterns"],
      "description": "整份报告的归因开关（派生值，不是第二真相源）：可由 attribution_policy + by_state + score.voided + process_fact 重算。作废或缺过程一律 false/false —— 下游只读这一个开关，不必解读 notes 的措辞（用户要求：作废时『不记能力短板』必须有执行者，不能只写在文案里）",
      "properties": {
        "counts_toward_mastery": { "type": "boolean" },
        "emit_error_patterns": { "type": "boolean" }
      }
    },
    "process_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "submitted", "missing"],
      "description": "流程事实（P2 / Q5-D1）：这道题要不要过程、这次交没交。中性记录，不是能力判断——缺过程只在 required=true 时压制分数与归因，**不改写断言状态、不写进 error_patterns / skill_gaps**。required 来自任务 YAML 的 submission_requirements.requires_process；submitted = trace 通过结构校验 或 submission.process_note 非空（写『没思路』也算交了）；missing = required 且未 submitted。执行者（2026-11-19 人拍甲 / B-04i）：mastery.skill_evidence() 读 missing=true ⇒ 该提交整份不计掌握度（与 voided 同款排除，提交行与报告照留）；字段缺失或非布尔时报错，不默认 false",
      "properties": {
        "required": { "type": "boolean" },
        "submitted": { "type": "boolean" },
        "missing": { "type": "boolean" }
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "description": "必须与任务的两个 rubric 数组一一对应：不多、不少、不重复，顺序为先 gate 后 credit（由 builder 保证，schema 只能保证结构）",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "layer", "type", "weight", "state", "skill_id", "error_patterns", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^R[0-9]+_[a-z0-9_]+$" },
          "layer": {
            "enum": ["gate", "credit"],
            "description": "gate = 门禁（不计分，fail 即整份不合格）；credit = 积分（计入分母）"
          },
          "type": { "type": "string", "minLength": 1 },
          "weight": {
            "type": "number",
            "minimum": 0,
            "description": "gate 层恒为 0（列表里保留该字段是为了断言结构统一，不是权重）"
          },
          "state": { "enum": ["pass", "fail", "blocked", "unscored"] },
          "skill_id": {
            "type": ["string", "null"],
            "description": "null = 只计分不归因（R1/R5 在当前三技能分类学里无归属，P5 拍板走 gate 通道）"
          },
          "error_patterns": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "uniqueItems": true
          },
          "reason_code": {
            "enum": [
              "trace_not_reported",
              "trace_invalid",
              "dependency_blocked",
              "tool_no_response",
              "invoke_timeout",
              "artifact_invalid"
            ]
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["observed", "expected"],
            "properties": {
              "observed": { "description": "实际观测到的值（任意类型，可 null）" },
              "expected": { "description": "任务 YAML 声明的期望值（任意类型，可 null）" },
              "extra": { "type": "object" }
            }
          },
          "note": { "type": "string" }
        },
        "allOf": [
          {
            "if": { "properties": { "layer": { "const": "gate" } }, "required": ["layer"] },
            "then": { "properties": { "weight": { "const": 0 } } }
          },
          {
            "if": { "properties": { "layer": { "const": "credit" } }, "required": ["layer"] },
            "then": { "properties": { "weight": { "exclusiveMinimum": 0 } } }
          },
          {
            "if": { "properties": { "state": { "const": "fail" } }, "required": ["state"] },
            "then": { "properties": { "error_patterns": { "minItems": 1 } } }
          },
          {
            "if": { "properties": { "state": { "enum": ["pass", "blocked", "unscored"] } }, "required": ["state"] },
            "then": { "properties": { "error_patterns": { "maxItems": 0 } } }
          },
          {
            "if": { "properties": { "state": { "enum": ["blocked", "unscored"] } }, "required": ["state"] },
            "then": { "required": ["reason_code"] }
          }
        ]
      }
    },
    "skill_gaps": {
      "type": "array",
      "description": "只做聚合，不做推断：失败断言按技能归类，weight_lost 是这些断言的权重之和。归因优先级＝断言自己声明的 skill_id（Q10=A，一位不改）；只有断言**没声明** skill_id 时才查 docs/error-patterns-v0.yaml 的 mapped_skill_ids 兜底（B-06 / ROADMAP R-2），兜底出现一对多时权重按技能数等分，且 Σweight_lost ≤ credit.total_weight（builder 有硬校验）。两条路都产不出技能归属的失败（R1/R5）不进本数组，改由 unattributed_patterns 留痕。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skill_id", "failed_assertions", "patterns", "weight_lost"],
        "properties": {
          "skill_id": { "type": "string", "minLength": 1 },
          "failed_assertions": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "patterns": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "weight_lost": { "type": "number", "minimum": 0 },
          "attributed_by": {
            "enum": ["assertion", "mapping", "assertion+mapping"],
            "description": "该缺口由哪条路归因：assertion＝断言自带 skill_id；mapping＝词表 mapped_skill_ids 兜底；加号＝两类失败落在同一技能上。可选字段（旧报告没有），但新报告一律写——否则审计时无法区分「归因来自任务作者声明」与「来自词表兜底」，B-06 是否真生效就无从判断"
          }
        }
      }
    },
    "unattributed_patterns": {
      "type": "array",
      "description": "有错误模式但没有技能归属的失败（R1/R5 这类门禁断言）。它们不进 skill_gaps——塞进任何技能都会让该技能的错误模式统计失真——但也不能静默丢弃：P5 的教训是『没交产物』在报告里曾完全不留痕。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assertion_id", "layer", "patterns"],
        "properties": {
          "assertion_id": { "type": "string" },
          "layer": { "enum": ["gate", "credit"] },
          "patterns": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" },
      "description": "报告不自洽或有未覆盖情况时的显式说明（例如『两态同时成立』不允许静默）"
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checked"],
      "description": "P3 对账结论（2026-11-19 人拍：三态标记进报告 JSON，notes 只写人话）。字段缺失表示『未做对账』，不表示『对账通过』。**不进 score、不进断言、不计掌握度**——分母恒定，做成断言等于给每份提交收普遍税。",
      "properties": {
        "status": { "enum": ["verified", "unverifiable", "mismatch"], "description": "verified=每个值都有过程出处；unverifiable=推导值/记录不足（数据不足，不是答错）；mismatch=有值对不上（疑似编造，交人复核）" },
        "checked": { "type": "array", "items": { "type": "object" } },
        "counts_as_evidence": { "type": "boolean" },
        "reason": { "type": "string" }
      }
    },
    "judge_scores": {
      "type": "array",
      "description": "B-04b：双评的逐次原始记录。**只有跑了 judge 才出现**；字段缺失表示『未评价』，不表示『评了 0 次』。judge 是软分侧证：它不参与 score / assertions / report_attribution / detected_patterns 的任何计算。",
      "items": { "$ref": "#/$defs/judgeScore" }
    },
    "judge_agreement": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "B-04b：双评一致率（两两比较中 rating 相同的比例，口径见 src/arena/llm_judge.py 模块文档）。低值说明判据表述有歧义，不等于考生答错；低于调用方给的阈值时进 arbitration_queue。"
    },
    "rubric_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "B-04e：这份报告按哪版判据判的——rubric_gate + rubric_credit 规范化后的 sha256（算法与版本见 src/arena/diagnosis_report.py 的 FINGERPRINT_VERSION）。用途只有一个：判据改动后识别『哪些历史提交需要重评』。**字段缺失表示『生成这份报告时还没有这个概念』，不表示『判据为空』**；历史报告一律缺失，不要用空串或默认值替它参与比较——那会把『不知道』伪装成『一样』。"
    },
    "rubric_rule_fingerprints": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^\\S.*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "description": "B-04g：单条规则级别的判据指纹（规则 id → sha256，算法版本见 RULE_FINGERPRINT_VERSION）。与 rubric_fingerprint 分工：那个决定『要不要重评』（整份判据变没变），这个回答『哪一条规则的判据变了、谁的提交当年用到了它』。**不可用于替代 rubric_fingerprint 做重评范围判断**：规则在数组里换位置只改整份指纹，不改单条指纹，而换位置是有语义的改动。字段缺失同样表示『当年还没有这个概念』，不等于『规则没变』。"
    }
  },
  "$defs": {
    "judgeScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rating", "suspected_patterns"],
      "properties": {
        "rating": { "type": "integer", "minimum": 1, "maximum": 4 },
        "suspected_patterns": {
          "type": "array",
          "items": { "type": "string" },
          "description": "键名必须带『怀疑』语义：judge 报的不是检出，词表里每条模式的检出者由 detection_rule.assertion_id 唯一确定"
        },
        "rationale": { "type": "string" },
        "model": { "type": "string" },
        "latency_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["counts_toward_mastery", "emit_error_patterns"],
      "properties": {
        "counts_toward_mastery": { "type": "boolean" },
        "emit_error_patterns": { "type": "boolean" }
      }
    },
    "traceInvalidReason": {
      "description": "status_error_without_http_status 为保留取值（reserved, no producer）：§28.6 D3 已拍板保留不产出，当前五夹具与七种变异均无生产者；允许值集合不等于必须产出集合。",
      "enum": [
        "not_reported",
        "call_index_not_sequential",
        "timestamp_not_increasing",
        "missing_required_field",
        "field_type_invalid",
        "status_error_without_http_status"
      ]
    }
  }
}
