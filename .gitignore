# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# 密钥与环境
.env

# IDE / 系统
.idea/
.vscode/
Thumbs.db
.DS_Store

# 运行产物
*.log
*.sqlite3
.pytest_cache/

# pytest 的 junit 报告（证据归档时临时放在根目录，交给 scripts/test_evidence.py --reuse 读）
# 档案里只记相对名字，跑完即删；不忽略的话 `git add -A` 会把整份 junit 带进提交
.junit*.xml

# pytest 临时目录（`--basetemp=.pytest-tmp-xxx` 与 pytest 自建 cache 目录的产物）
# 里面是各轮测试生成的 arena.db，可随时重建，不该留在工作区里给评审看到
.pytest-tmp-*/
pytest-cache-files-*/

# 外部红队测试的隔离运行目录（未核证前不进 tests/，也不该被提交）
.redteam-tmp/

# Android（android/ 目录）
android/local.properties
android/.gradle/
android/build/
android/app/build/
android/.kotlin/
*.apk
*.aab
*.jks
*.keystore

# 试用包产物（scripts/make_trial_pack.py 生成，不进仓）
dist/
.pytest-tmp-run/
